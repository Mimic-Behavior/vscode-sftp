{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "lib": [
            "ES2023",
            "DOM"
        ],
        "module": "esnext",
        "moduleDetection": "force",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "paths": {
            "~/*": ["./src/*"]
        },
        "skipLibCheck": true,
        "strict": true,
        "target": "es2023",
        "types": ["vite/client"],
        "verbatimModuleSyntax": true
    }
}
