{
    "name": "mimic-sftp",
    "displayName": "Mimic Behavior - SFTP",
    "version": "0.3.0",
    "description": "Mimic Behavior - SFTP extension for VS Code",
    "homepage": "https://github.com/Mimic-Behavior/vscode-sftp",
    "license": "MIT",
    "author": "Mimic Behavior",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Mimic-Behavior/vscode-sftp.git"
    },
    "publisher": "mimic-behavior",
    "files": [
        "LICENSE",
        "out"
    ],
    "type": "module",
    "main": "./out/extension.cjs",
    "scripts": {
        "build": "tsc && vite build",
        "dev": "vite",
        "package": "vsce package --no-dependencies",
        "preview": "vite preview"
    },
    "dependencies": {
        "@mimic-behavior/ssh2": "^0.1.0",
        "@mimic-behavior/ssh2-sftp-client": "^0.1.0",
        "date-fns": "^4.4.0",
        "es-toolkit": "^1.52.0",
        "p-limit": "^7.3.2",
        "picomatch": "^4.0.7"
    },
    "devDependencies": {
        "@mimic-behavior/eslint-config": "^0.9.0",
        "@mimic-behavior/oxfmt-config": "^0.1.4",
        "@types/node": "~26.4.1",
        "@types/picomatch": "^4.0.3",
        "@types/ssh2": "^1.15.6",
        "@types/vscode": "^1.136.0",
        "@vscode/vsce": "^3.9.2",
        "eslint": "^10.10.0",
        "eslint-plugin-jsonc": "^3.4.2",
        "eslint-plugin-perfectionist": "^5.11.0",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-yml": "^3.8.1",
        "jiti": "^2.7.0",
        "oxfmt": "^0.66.0",
        "ssh2": "^1.17.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2"
    },
    "contributes": {
        "commands": [
            {
                "command": "sftp.clearSecrets",
                "title": "[SFTP] Clear Secrets"
            },
            {
                "command": "sftp.upload",
                "title": "[SFTP] Upload"
            }
        ],
        "configuration": {
            "properties": {
                "sftp": {
                    "properties": {
                        "targets": {
                            "default": [],
                            "description": "List of targets",
                            "items": {
                                "properties": {
                                    "concurrency": {
                                        "description": "How many files to upload at the same time (default is 8)",
                                        "maximum": 64,
                                        "minimum": 1,
                                        "type": "number"
                                    },
                                    "connection": {
                                        "properties": {
                                            "host": {
                                                "description": "Server address",
                                                "type": "string"
                                            },
                                            "passphrase": {
                                                "description": "Ask for passphrase",
                                                "type": "boolean"
                                            },
                                            "passphraseMaxAge": {
                                                "description": "Passphrase max age in days (default is 30 days)",
                                                "type": "number"
                                            },
                                            "password": {
                                                "description": "Ask for password",
                                                "type": "boolean"
                                            },
                                            "passwordMaxAge": {
                                                "description": "Password max age in days (default is 30 days)",
                                                "type": "number"
                                            },
                                            "port": {
                                                "description": "Server port",
                                                "type": "number"
                                            },
                                            "privateKey": {
                                                "description": "Path to private key for authentication",
                                                "type": "string"
                                            },
                                            "username": {
                                                "description": "User name",
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "host",
                                            "port",
                                            "username"
                                        ],
                                        "type": "object"
                                    },
                                    "mappings": {
                                        "description": "List of mappings",
                                        "items": {
                                            "properties": {
                                                "condition": {
                                                    "properties": {
                                                        "workspaceFolderName": {
                                                            "description": "Only apply the mapping if the workspace folder name matches",
                                                            "type": "string"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "from": {
                                                    "description": "Path to source directory (should start and end with a slash, \"/path/to/source/\")",
                                                    "pattern": "^/.+/$",
                                                    "type": "string"
                                                },
                                                "to": {
                                                    "description": "Path to remote directory (should start and end with a slash, \"/path/to/remote/\")",
                                                    "pattern": "^/.+/$",
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "from",
                                                "to"
                                            ],
                                            "type": "object"
                                        },
                                        "type": "array"
                                    },
                                    "mappingsOnly": {
                                        "description": "Only upload files that are mapped",
                                        "type": "boolean"
                                    },
                                    "name": {
                                        "description": "Server name",
                                        "type": "string"
                                    },
                                    "transfer": {
                                        "default": "stream",
                                        "description": "How file contents are written. \"stream\" sends one chunk at a time and works with every server. \"parallel\" pipelines chunks and is much faster on high latency links, but servers that expect sequential writes reject it; such a refusal falls back to \"stream\" automatically.",
                                        "enum": [
                                            "stream",
                                            "parallel"
                                        ],
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "connection",
                                    "name"
                                ],
                                "type": "object"
                            },
                            "type": "array"
                        }
                    },
                    "type": "object"
                }
            },
            "title": "sftp"
        },
        "menus": {
            "explorer/context": [
                {
                    "command": "sftp.upload"
                }
            ]
        }
    },
    "activationEvents": [],
    "engines": {
        "vscode": "^1.105.1"
    },
    "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
